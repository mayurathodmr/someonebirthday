:root {
 --pink:#f7a8c4; --deep:#c65e8b; --lav:#d8c5ff;
 --cream:#fff9f6; --ink:#574451; --white:#fff;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden}
.ambient{position:fixed;inset:0;z-index:-2;background:
radial-gradient(circle at 10% 15%,#ffe1ed 0,transparent 32%),
radial-gradient(circle at 90% 40%,#e9dcff 0,transparent 34%),
radial-gradient(circle at 45% 95%,#fff0d9 0,transparent 40%)}
.top-tag{position:absolute;top:24px;left:50%;transform:translateX(-50%);font-size:10px;letter-spacing:3px;color:#b77b98;white-space:nowrap}
.intro{min-height:100svh;display:grid;place-items:center;padding:70px 20px}
.intro-card,.message-card,.final-card{background:#ffffffa8;border:1px solid #fff;backdrop-filter:blur(22px);box-shadow:0 20px 70px #b879991c;border-radius:30px}
.intro-card{width:min(100%,480px);padding:55px 30px;text-align:center;animation:rise 1s ease}
.tiny-stars{color:#d78cac;letter-spacing:10px;margin-bottom:20px}
.gift{font-size:85px;cursor:pointer;display:inline-block;animation:bounce 2s infinite;filter:drop-shadow(0 10px 15px #e7a2c3)}
.eyebrow{font-size:10px;letter-spacing:3px;color:#b77998;margin:20px 0 12px;font-weight:700}
h1,h2{font-family:'Playfair Display',serif;font-weight:600;line-height:1.18}
.intro h1{font-size:clamp(35px,8vw,52px)}
.intro h1 span,.gradient{background:linear-gradient(110deg,#d66d9a,#a88ad9);background-clip:text;color:transparent}
.sub{color:#967e8b;font-size:14px;margin:16px auto 26px;max-width:290px;line-height:1.8}
.primary-btn{border:0;border-radius:50px;padding:15px 25px;background:linear-gradient(110deg,#e98eb2,#b99be9);color:white;font-weight:700;cursor:pointer;box-shadow:0 9px 25px #cf8cb53d;transition:.3s;font-size:13px}
.primary-btn:hover{transform:translateY(-4px);box-shadow:0 13px 30px #cf8cb566}
.bottom-note{font-size:11px;color:#b69ba9;margin-top:28px}
.hidden{display:none!important}
.section{padding:100px 7%;min-height:80vh;display:flex;align-items:center;justify-content:center}
.hero{min-height:100svh;gap:40px;max-width:1250px;margin:auto}
.hero-content{flex:1;max-width:560px}
.pill{display:inline-block;padding:9px 15px;border-radius:30px;background:#fff;border:1px solid #f3d8e5;color:#bd7b9a;font-size:10px;letter-spacing:2px;font-weight:700}
.script{font-family:'Sacramento',cursive;font-size:42px;color:#c879a0;margin-top:22px}
.hero h1{font-size:clamp(43px,7vw,76px);margin:12px 0 20px}
.hero-text{font-size:15px;line-height:1.9;color:#937c89;max-width:430px;margin-bottom:28px}
.sparkle{margin-top:25px;color:#d58eae;letter-spacing:12px}
.hero-art{width:min(40vw,420px);aspect-ratio:1;position:relative;display:grid;place-items:center}
.hero-circle{width:72%;height:72%;border-radius:50%;background:linear-gradient(135deg,#f8bfd4,#d9c5ff);padding:12px;box-shadow:0 25px 60px #c18eae44;position:relative;overflow:hidden}
.hero-circle img{width:100%;height:100%;object-fit:cover;border-radius:50%;position:relative;z-index:2}
.photo-placeholder{position:absolute;inset:0;display:grid;place-items:center;font-size:80px}
.orbit{position:absolute;border:1px dashed #d8a3c0;border-radius:50%;inset:4%;animation:spin 22s linear infinite}
.orbit-two{inset:12%;border-color:#c7b2e7;animation-direction:reverse}
.deco{position:absolute;font-size:30px;animation:bounce 3s infinite}
.d1{top:8%;left:12%;color:#dc7ba5}.d2{right:6%;top:30%;color:#c29cdb}.d3{bottom:10%;left:15%}.d4{right:12%;bottom:10%}
.section-heading{text-align:center;margin-bottom:50px}
.section-heading h2,.message-card h2,.cake-section h2{font-size:clamp(30px,5vw,46px);margin:18px 0}
em{color:#ce7ca3;font-weight:500}
.section-heading p,.cake-section>p{color:#9b8491;font-size:14px}
.gallery-section{display:block;max-width:1200px;margin:auto}
.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;max-width:1000px;margin:auto}
.polaroid{background:white;padding:12px 12px 20px;box-shadow:0 12px 35px #9b72851b;border-radius:5px;transition:.4s}
.polaroid:hover{transform:rotate(0) translateY(-12px) scale(1.04);z-index:2}
.polaroid img{width:100%;aspect-ratio:4/5;object-fit:cover;background:#f7e5ed}
.polaroid span{display:block;text-align:center;font-family:'Sacramento',cursive;font-size:24px;padding-top:10px;color:#a36e88}
.rotate-left{transform:rotate(-4deg)}.rotate-right{transform:rotate(4deg)}
.message-section{min-height:90vh}
.message-card{width:min(100%,650px);padding:55px 45px;text-align:center}
.letter-icon{font-size:65px;margin:25px 0 12px;animation:bounce 3s infinite}
.message-text{font-family:'Playfair Display',serif;font-size:17px;line-height:2;color:#8d7181;margin:25px auto;max-width:500px}
.signature{font-family:'Sacramento',cursive;font-size:34px;color:#c8759e}
.cake-section{flex-direction:column;text-align:center;gap:14px}
.cake-section h2{max-width:600px}
.cake{position:relative;width:230px;height:210px;margin:35px auto 20px}
.cake-bottom,.cake-layer,.cake-top{position:absolute;left:50%;transform:translateX(-50%);border-radius:14px}
.cake-bottom{width:210px;height:65px;bottom:28px;background:linear-gradient(#f6b4ce,#e78eae);box-shadow:inset 0 -10px #d77e9e}
.cake-layer{width:170px;height:48px;bottom:85px;background:#f9d8e7;box-shadow:inset 0 -8px #e7a6c1}
.cake-top{width:170px;height:22px;bottom:119px;background:#fff0f5;border-radius:50%}
.plate{position:absolute;bottom:16px;left:0;width:230px;height:15px;border-radius:50%;background:#dfc8df}
.candles{position:absolute;z-index:2;bottom:139px;left:50%;transform:translateX(-50%);display:flex;gap:32px}
.candles i{width:8px;height:30px;background:repeating-linear-gradient(45deg,#fff 0 5px,#e99cbd 5px 10px);border-radius:3px}
.flames{position:absolute;z-index:3;bottom:164px;left:50%;transform:translateX(-50%);display:flex;gap:26px;font-size:17px}
.flame{animation:flicker .5s infinite alternate}
.flame.off{visibility:hidden}
.wish-text{color:#c66e97;font-family:'Sacramento',cursive;font-size:30px;min-height:40px}
.final-card{padding:65px 35px;text-align:center;width:min(100%,600px)}
.final-stars{color:#d38aad;letter-spacing:12px}
.final-card h2{font-size:clamp(45px,8vw,70px);color:#cf7ba0;margin:20px 0}
.final-card p:not(.script){color:#977f8c;line-height:2;margin:20px 0 28px}
.final-decoration{font-size:30px;margin-top:35px;letter-spacing:8px}
footer{text-align:center;padding:35px;font-size:10px;letter-spacing:3px;color:#bb91a6}
.popup-overlay{position:fixed;inset:0;background:#5b3e5370;backdrop-filter:blur(9px);display:none;place-items:center;padding:20px;z-index:20}
.popup-overlay.show{display:grid;animation:fade .4s}
.popup-box{position:relative;background:#fff9fc;border-radius:28px;padding:45px 28px;text-align:center;width:min(100%,410px);box-shadow:0 25px 80px #4b294044;animation:rise .5s}
.close{position:absolute;right:20px;top:15px;border:0;background:none;font-size:27px;color:#b17c96;cursor:pointer}
.popup-emoji{font-size:65px}
.popup-box h2{font-size:35px;margin:15px 0}
.popup-box p:not(.eyebrow){font-size:13px;color:#967d8c;line-height:1.8;margin:15px 0 24px}
.toast{position:fixed;bottom:25px;left:50%;transform:translate(-50%,100px);background:#fff;color:#b66d91;padding:14px 24px;border-radius:50px;box-shadow:0 5px 30px #a76c8d30;z-index:30;transition:.5s}
.toast.show{transform:translate(-50%,0)}
.heart{position:fixed;bottom:-30px;z-index:-1;color:#e7a1c1;pointer-events:none;animation:floatUp linear forwards}
@keyframes rise{from{opacity:0;transform:translateY(25px)}to{opacity:1;transform:translateY(0)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes flicker{to{transform:scale(1.2) rotate(8deg)}}
@keyframes floatUp{to{transform:translateY(-110vh) rotate(360deg);opacity:0}}
@media(max-width:750px){
 .section{padding:75px 22px;min-height:auto}
 .hero{flex-direction:column-reverse;text-align:center;padding-top:90px;gap:20px;min-height:100svh}
 .hero-content{width:100%}.hero-text{margin:0 auto 25px}
 .hero-art{width:min(75vw,330px)}
 .gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
 .message-card{padding:40px 23px}
 .message-text{font-size:15px}
 .gallery-section{padding-top:90px;padding-bottom:90px}
}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;scroll-behavior:auto!important}}

.special-photo{min-height:85vh;text-align:center}
.special-photo-card{width:min(100%,650px)}
.special-photo-card h2{font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,48px);margin:22px 0}
.special-photo-card h2 em{color:#cd7da3}
.final-photo-frame{width:min(100%,340px);margin:25px auto;padding:13px 13px 20px;background:white;box-shadow:0 20px 55px #bb7b992d;transform:rotate(-3deg);border-radius:5px}
.final-photo-frame img{width:100%;aspect-ratio:4/5;object-fit:cover}
.final-photo-frame span{display:block;font-family:'Sacramento',cursive;font-size:26px;color:#b36e8c;padding-top:12px}
.special-photo-card>p{color:#987f8e;font-size:13px;margin-top:25px}



/* ===================================
   LUXURY ROMANTIC PREMIUM EXPERIENCE
=================================== */

:root {
  --love-pink: #ff6f9f;
  --love-rose: #e84f88;
  --love-gold: #e8bd91;
  --love-dark: #241323;
  --love-light: #fff2f7;
  --love-text: #634456;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 25px;
}

body {
  font-family: 'Poppins', sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3 {
  font-family: 'Playfair Display', serif;
  letter-spacing: .3px;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

button {
  font-family: 'Poppins', sans-serif;
  cursor: pointer;
  transition: transform .3s ease, box-shadow .3s ease;
}

button:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px #e85d963d;
}

img {
  max-width: 100%;
}

/* Premium headings */
h1, h2 {
  text-wrap: balance;
}

h1 {
  text-shadow: 0 5px 25px #e96d9a30;
}

/* Premium buttons */
.main-btn, button {
  border-radius: 50px;
}

.main-btn {
  background: linear-gradient(135deg,#ff9dbd,#e84f88);
  color: white;
  border: 1px solid #ffffff80;
  padding: 15px 28px;
  font-weight: 600;
  box-shadow: 0 8px 25px #e84f8840;
  position: relative;
  overflow: hidden;
}

.main-btn::after {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 70%;
  height: 100%;
  background: linear-gradient(90deg,transparent,#ffffff80,transparent);
  transform: skewX(-20deg);
  transition: .7s;
}

.main-btn:hover::after {
  left: 150%;
}

/* Image gallery */
img {
  transition: transform .6s cubic-bezier(.2,.8,.2,1),
              filter .5s ease,
              box-shadow .5s ease;
}

img:hover {
  filter: saturate(1.12) brightness(1.04);
}

.memory-card, .photo-card, .gallery-item {
  overflow: hidden;
  border-radius: 22px;
  box-shadow: 0 12px 35px #a84d7620;
  transition: transform .4s ease, box-shadow .4s ease;
}

.memory-card:hover, .photo-card:hover, .gallery-item:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 45px #a84d7638;
}

.memory-card img, .photo-card img, .gallery-item img {
  transition: transform .7s ease;
}

.memory-card:hover img, .photo-card:hover img, .gallery-item:hover img {
  transform: scale(1.07);
}

/* Glass cards */
.card, .memory-card, .letter-card, .marathi-card {
  backdrop-filter: blur(15px);
}

/* Section spacing */
section {
  position: relative;
  isolation: isolate;
}

/* Floating romantic background glow */
body::before {
  content: "";
  position: fixed;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  top: 10%;
  left: -180px;
  background: #ff8dbb;
  filter: blur(130px);
  opacity: .13;
  pointer-events: none;
  z-index: -1;
}

/* Reveal animation */
.reveal-love {
  opacity: 0;
  transform: translateY(35px);
  transition: opacity .9s ease, transform .9s cubic-bezier(.2,.7,.2,1);
}

.reveal-love.visible-love {
  opacity: 1;
  transform: translateY(0);
}

/* Letter and special message */
.letter-card {
  border: 1px solid #ffffffb0;
  box-shadow: 0 20px 60px #a84d7620;
  border-radius: 28px;
}

/* Romantic glow */
@keyframes romanticGlow {
  0%,100% { box-shadow: 0 0 12px #ff8dbb25; }
  50% { box-shadow: 0 0 35px #ff8dbb70; }
}

@keyframes softFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes romanticPulse {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.09); }
}

@keyframes sparkle {
  0%,100% { opacity: .45; transform: scale(.8); }
  50% { opacity: 1; transform: scale(1.25); }
}

/* Envelope and gift animation */
.gift-box, .gift, .envelope {
  transition: transform .5s ease, filter .5s ease;
}

.gift-box:hover, .gift:hover, .envelope:hover {
  transform: translateY(-8px) rotate(-2deg);
  filter: drop-shadow(0 12px 18px #ed80ad55);
}

/* Floating heart */
.floating-heart {
  animation: softFloat 3s ease-in-out infinite;
}

/* Cake glow */
.cake-scene {
  filter: drop-shadow(0 15px 22px #ff8eb744);
}

/* Premium scrollbar */
::-webkit-scrollbar {
  width: 7px;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(#ff9fbd,#d85b91);
  border-radius: 20px;
}

::-webkit-scrollbar-track {
  background: #fff1f6;
}

/* Mobile responsive */
@media(max-width:768px) {
  body {
    font-size: 14px;
  }

  section {
    scroll-margin-top: 15px;
  }

  h1 {
    font-size: clamp(34px,10vw,52px);
  }

  h2 {
    font-size: clamp(27px,7vw,40px);
  }

  .main-btn {
    padding: 14px 22px;
    font-size: 13px;
  }

  img {
    max-width: 100%;
  }
}

@media(prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}

/* ===== PREMIUM BIRTHDAY EXPERIENCE ===== */
:root{
  --rose:#ff5c93;
  --gold:#f5c58b;
  --wine:#351327;
}

body{
  background:linear-gradient(135deg,#fff5f8,#fce8f1,#f4eaff);
  background-attachment:fixed;
}

section{
  overflow:visible;
}

.polaroid{
  position:relative;
  border-radius:16px;
  padding:11px 11px 20px;
  isolation:isolate;
  transition:transform .5s ease,box-shadow .5s ease;
}

.polaroid::before{
  content:"";
  position:absolute;
  inset:-3px;
  border-radius:18px;
  background:conic-gradient(from 0deg,#ff5c93,#f5c58b,#d7a5ff,#ff5c93);
  z-index:-1;
  animation:frameRotate 5s linear infinite;
}

.polaroid::after{
  content:"";
  position:absolute;
  inset:-7px;
  border:1px solid #ff9fbe;
  border-radius:21px;
  opacity:.55;
  animation:framePulse 2.5s ease-in-out infinite;
  pointer-events:none;
}

.polaroid img{
  display:block;
  border-radius:9px;
  position:relative;
}

.polaroid:hover{
  transform:translateY(-12px) rotate(0deg) scale(1.04);
  box-shadow:0 20px 50px #d75b9140;
}

.hero-circle{
  border:3px solid #fff;
  outline:2px solid #e99abb;
  animation:photoGlow 3s ease-in-out infinite;
}

.hero-circle img{
  transition:transform 1s ease;
}

.hero-circle:hover img{
  transform:scale(1.1);
}

.primary-btn{
  position:relative;
  overflow:hidden;
  background:linear-gradient(120deg,#ff8eb4,#d75b91,#b68be9);
  background-size:200% 200%;
  animation:buttonShine 4s ease infinite;
  box-shadow:0 8px 30px #df6e9d55;
}

.primary-btn:active{
  transform:scale(.96);
}

.intro-card,.message-card,.final-card,.popup-box{
  border:1px solid #ffffffc9;
  box-shadow:0 25px 80px #9b47772b, inset 0 0 25px #fff8;
}

.section-heading h2,
.message-card h2,
.cake-section h2{
  text-shadow:0 5px 25px #d86e9c25;
}

.love-special,.cake-surprise,.love-final{
  position:relative;
  padding:90px 22px;
  text-align:center;
  overflow:hidden;
}

.love-content{
  position:relative;
  z-index:2;
  max-width:720px;
  margin:auto;
  padding:45px 30px;
  border:1px solid #ffffffb5;
  border-radius:30px;
  background:#ffffffa8;
  backdrop-filter:blur(18px);
  box-shadow:0 25px 80px #a94d7720;
}

.love-content h2{
  font-size:clamp(32px,7vw,55px);
  margin:20px 0;
}

.love-content p{
  line-height:2;
  color:#806174;
  margin:17px auto;
  font-size:15px;
}

.love-highlight{
  color:#c34e80!important;
  font-weight:600;
}

.cake-scene{
  margin:45px auto;
  animation:softFloat 4s ease-in-out infinite;
}

.love-final{
  background:linear-gradient(135deg,#351327,#59213f,#32152d);
  color:white;
}

.love-final h2{
  color:#ffc1d7;
  font-size:clamp(32px,7vw,52px);
  margin:20px 0;
}

.love-final p,.love-final span{
  color:#ffe0eb;
  line-height:2;
}

.final-heart{
  font-size:75px;
  animation:heartBeat 1.5s infinite;
}

/* Torch / flashlight effect */
body::after{
  content:"";
  position:fixed;
  inset:0;
  z-index:100;
  pointer-events:none;
  opacity:0;
  background:radial-gradient(
    circle 150px at var(--torch-x,50%) var(--torch-y,50%),
    #ffffff35 0%,
    #ffb8d51c 35%,
    transparent 75%
  );
  transition:opacity .25s ease;
}

body.torch-active::after{
  opacity:1;
}

/* Floating birthday sparkles */
.birthday-sparkle{
  position:fixed;
  z-index:5;
  pointer-events:none;
  animation:sparkleFly 3s ease-out forwards;
}

/* Scroll reveal */
.reveal-love{
  opacity:0;
  transform:translateY(35px);
  transition:opacity .9s ease,transform .9s ease;
}

.reveal-love.visible-love{
  opacity:1;
  transform:translateY(0);
}

@keyframes frameRotate{
  to{transform:rotate(360deg)}
}

@keyframes framePulse{
  0%,100%{opacity:.25;transform:scale(1)}
  50%{opacity:.8;transform:scale(1.025)}
}

@keyframes photoGlow{
  0%,100%{box-shadow:0 15px 40px #e68bb855}
  50%{box-shadow:0 15px 60px #d75b91a0}
}

@keyframes buttonShine{
  0%,100%{background-position:0% 50%}
  50%{background-position:100% 50%}
}

@keyframes heartBeat{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.16)}
}

@keyframes sparkleFly{
  0%{transform:translateY(0) scale(.5);opacity:0}
  20%{opacity:1}
  100%{transform:translateY(-150px) rotate(180deg) scale(1.4);opacity:0}
}

@media(max-width:750px){
  .gallery{gap:22px 15px}
  .polaroid{padding:8px 8px 15px}
  .love-content{padding:35px 20px}
  .love-content p{font-size:14px}
}

@media(prefers-reduced-motion:reduce){
  .polaroid::before,.polaroid::after,
  .hero-circle,.primary-btn,.final-heart{
    animation:none!important;
  }
}

/* ===== BIRTHDAY CAKE MAGIC ===== */

.cake{
  filter:drop-shadow(0 15px 25px #df7ca855);
  animation:cakeFloat 3s ease-in-out infinite;
}

.cake .flame{
  display:inline-block;
  transform-origin:bottom center;
  animation:candleFire .55s ease-in-out infinite alternate;
  filter:drop-shadow(0 0 9px #ff9d35);
}

.cake .flame:nth-child(2){
  animation-delay:.2s;
}

.cake .flame:nth-child(3){
  animation-delay:.35s;
}

.cake .flame.off{
  visibility:hidden;
  animation:none;
}

.cake-layer,.cake-bottom{
  box-shadow:0 8px 20px #c75c8c35;
}

.plate{
  box-shadow:0 8px 20px #b87da533;
}

.cake-scene{
  filter:drop-shadow(0 15px 25px #ff8eb766);
}

.cake-scene .candle i{
  animation:candleFire .6s infinite alternate;
  transform-origin:bottom;
}

.cake-scene.blown .candle i{
  animation:none;
  opacity:.5;
}

.cake-scene.blown{
  animation:cakeCelebrate .8s ease;
}

.cake-button{
  border:0;
  border-radius:50px;
  padding:15px 28px;
  color:white;
  font-weight:700;
  background:linear-gradient(120deg,#ff82ae,#d65b91);
  box-shadow:0 10px 30px #d65b9155;
  cursor:pointer;
}

#cake-message{
  color:#c34e80;
  font-weight:600;
  margin-top:20px;
  line-height:1.8;
}

@keyframes cakeFloat{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-9px)}
}

@keyframes candleFire{
  from{transform:scale(.85) rotate(-5deg)}
  to{transform:scale(1.15) rotate(6deg)}
}

@keyframes cakeCelebrate{
  0%{transform:scale(1)}
  50%{transform:scale(1.08) rotate(2deg)}
  100%{transform:scale(1)}
}

/* SIMPLE PHOTO ANIMATION */
.polaroid,
.photo-card,
.gallery-item,
.special-photo-card {
  overflow: hidden;
  border-radius: 18px;
  animation: photoFloat 4s ease-in-out infinite;
  box-shadow: 0 8px 25px rgba(225, 105, 160, 0.22);
}

.polaroid img,
.photo-card img,
.gallery-item img,
.special-photo-card img {
  width: 100%;
  display: block;
  transition: transform 0.7s ease, filter 0.7s ease;
  animation: photoZoom 6s ease-in-out infinite alternate;
}

.polaroid img:hover,
.photo-card img:hover,
.gallery-item img:hover,
.special-photo-card img:hover {
  transform: scale(1.08);
  filter: brightness(1.08);
}

@keyframes photoFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

@keyframes photoZoom {
  from { transform: scale(1); }
  to { transform: scale(1.045); }
}

@media (prefers-reduced-motion: reduce) {
  .polaroid,
  .photo-card,
  .gallery-item,
  .special-photo-card,
  .polaroid img,
  .photo-card img,
  .gallery-item img,
  .special-photo-card img {
    animation: none;
  }
}

/* =====================================
   DHANSHRI - PREMIUM BIRTHDAY THEME
===================================== */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&family=Dancing+Script:wght@500;600;700&display=swap');

:root{
  --pink:#e879a7;
  --rose:#c94f83;
  --deep:#8e365f;
  --cream:#fff9f7;
  --gold:#d9ae76;
  --text:#573849;
  --shadow:0 15px 45px rgba(180,90,130,.13);
}

*{
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body{
  font-family:'DM Sans',sans-serif !important;
  color:var(--text);
  background:
    radial-gradient(circle at 10% 10%,#ffe3ed 0,transparent 32%),
    radial-gradient(circle at 90% 80%,#fce8df 0,transparent 35%),
    linear-gradient(135deg,#fffaf8,#fff0f5,#fff9f2) !important;
  overflow-x:hidden;
}

h1,h2,h3{
  font-family:'Playfair Display',serif !important;
  letter-spacing:.3px;
  line-height:1.25;
}

p{
  font-family:'DM Sans',sans-serif !important;
  line-height:1.85;
}

button,.btn{
  font-family:'DM Sans',sans-serif !important;
  font-weight:700;
  letter-spacing:.3px;
  transition:all .3s ease !important;
  cursor:pointer;
}

button:hover,.btn:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 28px rgba(201,79,131,.25);
}

section{
  padding-top:65px;
  padding-bottom:65px;
}

img{
  max-width:100%;
}

.polaroid,
.photo-card,
.gallery-item,
.special-photo-card,
.message-card,
.final-card,
.love-content,
.love-final{
  border-radius:22px !important;
  box-shadow:var(--shadow);
  transition:transform .4s ease,box-shadow .4s ease;
}

.polaroid:hover,
.photo-card:hover,
.gallery-item:hover,
.special-photo-card:hover{
  transform:translateY(-7px) scale(1.015);
  box-shadow:0 20px 45px rgba(201,79,131,.22);
}

.polaroid img,
.photo-card img,
.gallery-item img,
.special-photo-card img{
  border-radius:16px;
  object-fit:cover;
}

.love-special,
.love-final{
  background:linear-gradient(145deg,#fff,#fff0f5) !important;
  border:1px solid rgba(217,174,118,.35);
  box-shadow:0 15px 45px rgba(201,79,131,.12);
}

.love-special h2,
.love-final h2{
  color:var(--rose);
}

.cake-scene,
.cake{
  filter:drop-shadow(0 15px 22px rgba(201,79,131,.22));
}

.intro,
.popup,
.modal{
  backdrop-filter:blur(14px);
}

a{
  color:var(--rose);
  transition:color .25s ease;
}

a:hover{
  color:var(--deep);
}

::selection{
  background:#f5bad1;
  color:#71334f;
}

/* Soft background sparkle */
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
  opacity:.24;
  background-image:
    radial-gradient(#e9a5c0 1px,transparent 1px),
    radial-gradient(#d9ae76 1px,transparent 1px);
  background-size:48px 48px,75px 75px;
  background-position:0 0,22px 25px;
}

body > *{
  position:relative;
}

/* Smooth entrance */
@keyframes premiumEntrance{
  from{opacity:0;transform:translateY(22px)}
  to{opacity:1;transform:translateY(0)}
}

.hero h1,
.hero h2,
.hero p{
  animation:premiumEntrance 1s ease both;
}

@media(max-width:600px){
  section{
    padding:42px 16px;
  }

  h1{
    font-size:clamp(30px,9vw,44px);
  }

  h2{
    font-size:clamp(24px,7vw,32px);
  }

  .polaroid,
  .photo-card,
  .gallery-item,
  .special-photo-card{
    border-radius:18px !important;
  }
}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:.01ms !important;
    transition-duration:.01ms !important;
    scroll-behavior:auto !important;
  }
}


/* ===== ELEGANT FLOATING HEARTS ===== */
.romantic-float{
  position:fixed;
  bottom:-35px;
  z-index:2;
  pointer-events:none;
  opacity:0;
  animation:romanticRise linear forwards;
  filter:drop-shadow(0 3px 5px #e879a755);
}

@keyframes romanticRise{
  0%{transform:translateY(0) rotate(0deg) scale(.7);opacity:0}
  15%{opacity:.65}
  80%{opacity:.55}
  100%{transform:translateY(-110vh) rotate(35deg) scale(1.15);opacity:0}
}

@media(prefers-reduced-motion:reduce){
  .romantic-float{display:none}
}

/* ===== PREMIUM BIRTHDAY SURPRISE EFFECTS ===== */

.cake-scene{
  position:relative;
  margin:35px auto;
  animation:cakeFloat 3s ease-in-out infinite;
}

.cake-top,.cake-middle,.cake-bottom{
  margin-left:auto;
  margin-right:auto;
  border-radius:14px 14px 9px 9px;
  background:linear-gradient(135deg,#ffd4e4,#f49abd,#d9689b);
  box-shadow:inset 0 5px 10px #ffffff88,0 8px 18px #bd5c8833;
}

.cake-top{width:110px;height:35px}
.cake-middle{width:145px;height:42px;margin-top:3px}
.cake-bottom{width:175px;height:48px;margin-top:3px}

.cake-plate{
  width:195px;
  height:12px;
  margin:5px auto 0;
  border-radius:50%;
  background:linear-gradient(90deg,#d9ae76,#fff0c9,#c99856);
  box-shadow:0 7px 15px #c58d9c55;
}

.cake-candles{
  display:flex;
  justify-content:center;
  gap:17px;
  position:relative;
  z-index:2;
}

.candle{
  width:9px;
  height:30px;
  border-radius:5px 5px 2px 2px;
  background:repeating-linear-gradient(135deg,#fff 0 5px,#ed8bb1 5px 10px);
  position:relative;
}

.candle i{
  position:absolute;
  width:10px;
  height:15px;
  left:0;
  top:-17px;
  border-radius:50% 50% 45% 45%;
  background:radial-gradient(circle at 50% 65%,#fff7a0 0 20%,#ffb43e 55%,#ff7043 100%);
  box-shadow:0 0 12px #ffb43e;
  animation:candleFire .5s infinite alternate;
}

.cake-scene.blown .candle i{
  opacity:0;
  transform:scale(.1);
}

.love-balloon{
  position:fixed;
  bottom:-100px;
  z-index:5;
  pointer-events:none;
  font-size:35px;
  animation:loveBalloonRise 8s linear forwards;
}

@keyframes loveBalloonRise{
  to{transform:translateY(-120vh) translateX(25px);opacity:0}
}

.love-petal{
  position:fixed;
  top:-30px;
  z-index:5;
  pointer-events:none;
  font-size:20px;
  animation:lovePetalFall 7s linear forwards;
}

@keyframes lovePetalFall{
  to{transform:translateY(110vh) rotate(500deg);opacity:0}
}

@media(max-width:480px){
  .cake-bottom{width:155px}
  .cake-middle{width:130px}
  .cake-top{width:100px}
  .cake-plate{width:175px}
}

/* ===== NORMAL PHOTO STYLE ===== */
.polaroid,
.photo-card,
.gallery-item,
.special-photo-card{
  animation:none !important;
  transform:none !important;
  transition:box-shadow .3s ease !important;
}

.polaroid img,
.photo-card img,
.gallery-item img,
.special-photo-card img{
  animation:none !important;
  transform:none !important;
  transition:none !important;
  filter:none !important;
}

.polaroid:hover,
.photo-card:hover,
.gallery-item:hover,
.special-photo-card:hover{
  transform:none !important;
}



